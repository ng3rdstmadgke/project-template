{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Skill",
      "WebSearch",
      "mcp__context7"
    ],
    "deny": [],
    "ask": [
      "Bash(git remote:*)",
      "Bash(terraform apply:*)",
      "Bash(make:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "praxis@praxis": true,
    "sample@niseko-agent-plugins": true
  },
  "extraKnownMarketplaces": {
    "praxis": {
      "source": {
        "source": "github",
        "repo": "ng3rdstmadgke/praxis"
      }
    }
  }
}