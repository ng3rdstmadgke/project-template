{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "NotebookEdit",
      "Write",
      "Skill",
      "WebSearch",
      "WebFetch",
      "Bash",
      "mcp__chrome-devtools__*",
      "mcp__context7__*",
      "mcp__next-devtools__*",
      "mcp__playwright__*"
    ],
    "deny": [],
    "ask": [
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(Kubectl delete:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl edit:*)",
      "Bash(terraform apply:*)",
      "Bash(make:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "next-devtools",
    "chrome-devtools",
    "playwright",
    "context7"
  ],
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "praxis@praxis": true
  }
}
